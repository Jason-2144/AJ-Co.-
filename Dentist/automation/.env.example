# Copy to .env for local runs. On Railway/Render, set these in the dashboard's
# Variables tab instead — never commit real values.

# Which client config to load from config/ (one deployment per practice)
CLIENT_CONFIG=default.json

# Set true to run everything without sending messages or writing to Appwrite.
# Every outbound action is logged instead. Always test with this first.
DRY_RUN=false

# --- Appwrite (shared backend the dashboard reads from) ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a7eafe70004501c7bf7
APPWRITE_DATABASE_ID=6a7ebc0000056a68c221
APPWRITE_API_KEY=

# --- Meta WhatsApp Cloud API (India clients) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you choose; must match what you enter in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=practice-os-verify

# --- Twilio (voice everywhere; SMS for US clients) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OpenAI (AI receptionist voice) ---
OPENAI_API_KEY=

# Public hostname of THIS service, no protocol. e.g. practice-abc.up.railway.app
PUBLIC_HOSTNAME=

# Where AI receptionist escalations get sent
FRONT_DESK_WHATSAPP_NUMBER=
