# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Appwrite (shared backend for all 8 products, read by the dashboard) ---
# Endpoint + project ID are hardcoded in src/lib/appwrite.ts (not secrets for
# the web SDK). The database ID below is only needed if you override the
# default already baked into appwrite.ts (real ID, not the "Practice OS"
# display name — Appwrite auto-generates IDs on creation).
VITE_APPWRITE_DATABASE_ID="6a7ebc0000056a68c221"

# --- Branding (per-client — set these when deploying for a new practice) ---
VITE_PRACTICE_NAME="Smile & Co. Dental Arts"
VITE_STAFF_NAME="Dr. Sarah"

# --- Automation service (see /automation) — powers every "Run Now" button ---
# The deployed Railway/Render URL, no trailing slash. Leave blank in local dev
# and the buttons will show a clear "not configured" error instead of hanging.
VITE_AUTOMATION_URL="https://your-app.up.railway.app"
