# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Also used by the Patient Re-Engagement feature (server.ts /api/whatsapp/generate)
# to write each message — preferred over local Ollama when set, since it works
# from a deployed server, not just localhost. Get a free key at aistudio.google.com/apikey.
# Also used by Beautiful Postman (server.ts /api/bp/*) to generate outreach emails.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to "gemini-3.6-flash" if unset.
GEMINI_MODEL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_WEBHOOK_URL: Webhook URL of the Google App Script to save form submissions to Google Sheets.
VITE_GOOGLE_WEBHOOK_URL=

# CALENDLY_URL: Redirect users to this Calendly link after form submission
VITE_CALENDLY_URL=

# VITE_DENTIST_DASHBOARD_URL: Deployed URL of the real Practice OS dashboard
# (the one wired to Appwrite + the automation service). Embedded via iframe
# at /dentist. Leave blank until that dashboard is actually deployed.
VITE_DENTIST_DASHBOARD_URL=

# VITE_PLACE_SCOUT_URL: Deployed URL of the real Place Scout lead-gen tool.
# Embedded via iframe on the staff /staff "Place Scout" tab. Leave blank
# until that app is actually deployed.
VITE_PLACE_SCOUT_URL=

# META_ACCESS_TOKEN / META_PHONE_NUMBER_ID / META_WABA_ID: Meta WhatsApp Cloud API
# credentials (Meta for Developers > your app > WhatsApp > API Setup). Preferred
# provider — checked before Twilio. No per-message markup, no paid-account wall.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# META_TEMPLATE_NAME / META_TEMPLATE_LANGUAGE: Name + language of the approved
# WhatsApp message template to send (e.g. "patient_reengagement" / "en"). Submit
# a template via the Message Templates API or Meta Business Manager, wait for
# approval, then set its name here.
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en

# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_FROM: Twilio WhatsApp
# credentials, used as a fallback provider only if META_ACCESS_TOKEN is unset.
# Leave blank to run in mock mode (messages are simulated, not actually sent).
# TWILIO_WHATSAPP_FROM should be a bare E.164 number, e.g. +14155238886 (Twilio's
# public sandbox number) or your own approved WhatsApp Business number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# TWILIO_CONTENT_SID: The approved WhatsApp Content Template's SID (starts with "HX").
# Required for real sends — Twilio rejects all outbound WhatsApp messages without one,
# even on the sandbox. Creating a template requires a paid (non-Trial) Twilio account,
# since the Content API is blocked entirely for Trial accounts.
TWILIO_CONTENT_SID=

# TWILIO_STATUS_CALLBACK_URL: Optional. Full URL Twilio should POST delivery/read
# status updates to, e.g. https://ajandco.site/api/whatsapp/webhook. Also set this
# as the "When a message comes in" webhook in the Twilio console to receive replies.
TWILIO_STATUS_CALLBACK_URL=

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Google Cloud OAuth 2.0 credentials used by
# Beautiful Postman (server.ts /api/bp/gmail/*) to connect real Gmail mailboxes with
# gmail.send scope and actually send email (not just draft). Create an OAuth client at
# console.cloud.google.com > APIs & Services > Credentials, enable the Gmail API, and
# add "{APP_URL}/api/bp/gmail/callback" as an authorized redirect URI.
# SECURITY: keep these server-side only. Never put the client secret in frontend code —
# see the note in src/services/gmail/MultiGmailAuthManager.ts for what NOT to do; that
# file already has a real secret hardcoded client-side and its Google Cloud client
# secret should be rotated in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
